# Copy to .env next to docker-compose.yml. Never commit the copied file.
#
# 2.0 is a separate Docker project (html-lore-v2) from frozen 1.x (port 8080).
# Point HTML_LORE_DATA at a *copy* of 1.x data, not the live 1.x volume.

# Bind loopback only. Caddy/Cloudflare on the same host still works.
# LAN access: set HTML_LORE_HTTP_BIND=0.0.0.0 (do not do this on rain).
HTML_LORE_HTTP_BIND=127.0.0.1
HTML_LORE_HTTP_PORT=3000
HTML_LORE_DATA=./data
HTML_LORE_UID=1000
HTML_LORE_GID=1000
HTML_LORE_TITLE=HTMlore
HTML_LORE_MAX_UPLOAD_BYTES=104857600
HTML_LORE_API_TOKEN=
# Built-in login is off by default. Leave these empty; put Cloudflare Access / Caddy in front.
# Set all three only if you still want the 1.x session screen.
HTML_LORE_AUTH_USERNAME=
HTML_LORE_AUTH_PASSWORD=
HTML_LORE_SESSION_SECRET=
HTML_LORE_SESSION_SECURE=false
HTML_LORE_SHARE_INTERACTIVE_ENABLED=true
# Override only when Docker Hub alpine is unavailable, e.g. node:22-bullseye
# HTML_LORE_NODE_IMAGE=node:22-alpine
